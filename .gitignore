# Archiso: arquivos gerados
/iso/work/
/iso/repo/
/iso/out/
/iso/*.iso
/iso/*.iso.sig
/iso/*.img
/iso/*.img.sig
/iso/*.qcow2
/iso/*.vdi
/iso/*.vmdk
/iso/*.pkg.tar
/iso/*.pkg.tar.*

# Cache e arquivos temporários
/var/cache/pacman/pkg/
/pkg/
/src/
*.log
*.tmp
*.temp
*.bak
*.old
*~

# Backups locais
/backups/
/backup/
/iso/backups/
/iso/profile-backup-*/
/iso/profile/backup/

# Arquivos locais de editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Credenciais e segredos
.env
.env.*
!.env.example
*.pem
*.key
*.token
secrets/
credentials/

# Arquivos temporários do sistema
.Trash-*/
lost+found

# Cache Python
__pycache__/
*.py[cod]

# Lista antiga de pacotes
/iso/profile/packages.x86_64.backup*

# Arquivos de autenticação da ISO live
/iso/profile/airootfs/etc/shadow


# Artefatos de compilação do Archiso
/iso/out-check/
/iso/work-check/
